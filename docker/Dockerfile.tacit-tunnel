# syntax=docker/dockerfile:1
# SSH tunnel sidecar: forwards the GPU host's loopback-bound Tacit gateway onto the
# shared network, so containers (whose 127.0.0.1 is their own) can reach it.
#
# Why this exists: the systemd stack joins `pattern-tei-shared` only, so a host-level
# `ssh -L 8100:127.0.0.1:8100 gpu-host` is invisible inside design-pattern-mcp — and
# the gateway has no auth of its own (same reason the dev compose confines Tacit to
# 127.0.0.1), so it must never be published on an external interface. This sidecar
# runs the ssh client itself, listens on 0.0.0.0:8100 INSIDE the container, and is
# reachable only as `tacit-tunnel:8100` on the shared network — no published port.
#
# Auth is a read-only bind-mounted key (see systemd/docker-compose.yml); the container
# carries no credentials of its own. `ServerAliveInterval` + `ExitOnForwardFailure` +
# `restart: unless-stopped` heal dropped tunnels by container restart.
#
#   docker build -f docker/Dockerfile.tacit-tunnel -t design-pattern-tacit-tunnel:latest .
#   make docker-build-tacit-tunnel

# python3 is for the healthcheck probe only (same TCP-probe shape as the other sidecars).
FROM alpine:3.21

RUN apk add --no-cache openssh-client-default python3

COPY docker/tacit-tunnel-entrypoint.sh /usr/local/bin/tacit-tunnel-entrypoint.sh
RUN chmod +x /usr/local/bin/tacit-tunnel-entrypoint.sh

EXPOSE 8100

ENTRYPOINT ["tacit-tunnel-entrypoint.sh"]
