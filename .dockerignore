# Build context is the project root. Exclude everything not needed in the image.
#
# NOTE: no bare `*.md` pattern — it matches at every level and would drop
# docs/design-patterns.md, which the catalog loader parses (canonical order index).
.git
.omp
.venv
.mypy_cache
.pytest_cache
.ruff_cache
*.egg-info
.env
tests
scripts
docker
# The decision-model images (docker/Dockerfile.tacit, docker/Dockerfile.clm) COPY their
# trainer script and entrypoint from the context, so keep those specific files while the
# rest of scripts/ and docker/ stay out of the server image.
!scripts/decision_models/tacit_self_distill.py
!scripts/decision_models/export_clm_dataset.py
!docker/tacit-entrypoint.sh
!docker/clm-entrypoint.sh
Makefile
README.md
whitelist.py
.python-version
.gitignore
.pre-commit-config.yaml
