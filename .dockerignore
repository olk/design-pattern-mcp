# Build context is the project root. Exclude everything not needed in the image.
#
# NOTE: no bare `*.md` pattern — it matches at every level and would drop
# docs/design-patterns.md, which the catalog loader parses (canonical order index).
.git
.omp
.venv
.mypy_cache
.pytest_cache
.ruff_cache
*.egg-info
.env
tests
scripts
docker
# The decision-model image (docker/Dockerfile.tacit) COPYs its trainer script and
# entrypoint from the context, so keep those specific files while the rest of scripts/
# and docker/ stay out of the server image. The trainer's inputs (src/decisions/
# seam_prompts.py, qa/qa.jsonl, qa/typed/rerank_pairs.jsonl) are outside the excluded
# trees and ship as-is.
#
# The CLM image (docker/Dockerfile.clm) has the same shape and needs every one of its
# own COPY sources here. Omitting one fails the build at that COPY with "failed to
# calculate checksum ... not found", AFTER the layer(s) above it — and
# `docker build --check` does NOT validate that a COPY source exists in the context, so
# this list is the only guard.
!scripts/decision_models/tacit_self_distill.py
!scripts/decision_models/export_clm_dataset.py
!scripts/decision_models/clm_eval_gate.py
!scripts/decision_models/clm_rank_parity.py
!scripts/decision_models/clm_preflight.py
!docker/tacit-entrypoint.sh
!docker/clm-entrypoint.sh
Makefile
README.md
whitelist.py
.python-version
.gitignore
.pre-commit-config.yaml

# Decision-model trained artifacts MUST stay in the build context: the
# runtime-distilled-cached stage COPYs models/tacit-4b/ back into the image.
# Never exclude models/.
!models/tacit-4b/
