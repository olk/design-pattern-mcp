# Build context is the project root. Exclude everything not needed in the image.
#
# NOTE: no bare `*.md` pattern — it matches at every level and would drop
# docs/design-patterns.md, which the catalog loader parses (canonical order index).
.git
.omp
.venv
.mypy_cache
.pytest_cache
.ruff_cache
*.egg-info
.env
tests
scripts
docker
# The linear style head image (docker/Dockerfile.style-head): the trainer runs in the build
# and the server is the runtime entrypoint. The corpus (qa/) and the shared prompt
# vocabulary (src/decisions/) are outside the excluded trees and ship as-is.
!scripts/decision_models/train_style_head.py
!scripts/decision_models/style_head_serve.py
Makefile
README.md
whitelist.py
.python-version
.gitignore
.pre-commit-config.yaml

