[Unit]
Description=Design Pattern MCP server (Docker Compose stack; TEI via pattern-tei-infra)
Documentation=https://github.com/olk/design-pattern-mcp
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target pattern-tei-infra.service
After=pattern-tei-infra.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=graemer
WorkingDirectory=/etc/design-pattern-mcp
EnvironmentFile=/etc/design-pattern-mcp/.env
# File list: base only by default; the decision overlay joins when .env sets
# COMPOSE_FILE=docker-compose.yml:docker-compose.decision-models.yml (see README
# "Decision models"). Compose resolves relative names against WorkingDirectory.
# No Environment=COMPOSE_FILE= default: EnvironmentFile wins over Environment= by
# source type (man systemd.exec), so a default here would only shadow the opt-in —
# and compose already defaults to docker-compose.yml when COMPOSE_FILE is unset.
ExecStartPre=/usr/bin/docker image inspect design-pattern-mcp:latest
# Style-head image guard (unconditional: the head runs in the base file). Same
# local-only reasoning as the MCP guard above — a missing build must fail here with
# a named error, not at container creation.
ExecStartPre=/usr/bin/docker image inspect design-pattern-style-head:latest
ExecStartPre=/usr/bin/docker compose config --quiet
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecReload=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
