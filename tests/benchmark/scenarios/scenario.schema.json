{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://design-pattern-mcp.local/tests/benchmark/scenarios/scenario.schema.json",
  "title": "Benchmark scenario",
  "description": "One Stage-0 benchmark scenario: the request the pipeline receives plus its expert-reviewed label. Validated at load by tests/benchmark/harness/config.py; label ids must resolve to pattern/<id>.json records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "family",
    "category",
    "description",
    "decision_statement",
    "expected",
    "split"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 80,
      "description": "Stable corpus-unique id."
    },
    "family": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "description": "Catalog ### subgroup of the expected primary; the split is family-disjoint."
    },
    "category": {
      "$ref": "#/definitions/patternCategory",
      "description": "Catalog category of the expected primary (near-miss discrimination guard)."
    },
    "language": {
      "type": [
        "string",
        "null"
      ],
      "description": "Requested language; null = generic mode."
    },
    "description": {
      "type": "string",
      "minLength": 40,
      "maxLength": 10000,
      "description": "The request text handed to run_design (never names the pattern)."
    },
    "decision_statement": {
      "type": "string",
      "minLength": 10,
      "maxLength": 400,
      "description": "The single decision the scenario is about (offline script input)."
    },
    "hints": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional caller hints (guide §1.2); omitted or null keys mean 'no hint'.",
      "properties": {
        "architecture_style": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60
        },
        "paradigm": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60
        },
        "focus": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "acceptable_primary"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "The expert-chosen primary pattern."
        },
        "acceptable_primary": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "description": "Every acceptable primary (>=2 ids, sibling-inclusive)."
        },
        "acceptable_supporting": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "description": "Acceptable supporting patterns."
        }
      }
    },
    "split": {
      "enum": [
        "train",
        "holdout"
      ],
      "description": "Family-disjoint evaluation split."
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000,
      "description": "Authoring rationale for the reviewer (why these labels)."
    }
  },
  "definitions": {
    "patternCategory": {
      "enum": [
        "domain-modeling",
        "construction-composition",
        "behavior-selection",
        "interaction-boundary",
        "workflow-messaging",
        "persistence-state",
        "concurrency-resilience",
        "security-verification",
        "specialized-components"
      ]
    }
  }
}
