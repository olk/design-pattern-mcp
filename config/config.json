{
  "logging_level": "{env:DESIGN_PATTERN_LOGGING_LEVEL:-INFO}",
  "logging_format": "{env:DESIGN_PATTERN_LOGGING_FORMAT:-json}",
  "transport": "{env:DESIGN_PATTERN_TRANSPORT:-stdio}",
  "host": "{env:DESIGN_PATTERN_HOST:-0.0.0.0}",
  "port": "{env:DESIGN_PATTERN_PORT:-8050}",
  "generator": {
    "provider": "{env:DESIGN_PATTERN_GENERATOR_PROVIDER:-openai}",
    "config": {
      "model": "{env:DESIGN_PATTERN_GENERATOR_MODEL:-gpt-4o-mini}",
      "base_url": "{env:DESIGN_PATTERN_GENERATOR_BASE_URL:-https://api.openai.com/v1}",
      "api_key": "{env:DESIGN_PATTERN_GENERATOR_API_KEY:-}",
      "temperature": "{env:DESIGN_PATTERN_GENERATOR_TEMPERATURE:-0.1}",
      "top_p": "{env:DESIGN_PATTERN_GENERATOR_TOP_P:-1.0}",
      "top_k": "{env:DESIGN_PATTERN_GENERATOR_TOP_K:-20}",
      "timeout_seconds": "{env:DESIGN_PATTERN_GENERATOR_TIMEOUT_SECONDS:-120.0}",
      "generation_batch_size": "{env:DESIGN_PATTERN_GENERATOR_GENERATION_BATCH_SIZE:-5}",
      "generation_max_concurrency": "{env:DESIGN_PATTERN_GENERATION_MAX_CONCURRENCY:-2}",
      "circuit_breaker_failure_threshold": "{env:DESIGN_PATTERN_GENERATOR_CIRCUIT_BREAKER_FAILURE_THRESHOLD:-3}",
      "circuit_breaker_cooldown_seconds": "{env:DESIGN_PATTERN_GENERATOR_CIRCUIT_BREAKER_COOLDOWN_SECONDS:-60.0}"
    }
  },
  "embedder": {
    "provider": "{env:DESIGN_PATTERN_EMBEDDER_PROVIDER:-tei}",
    "config": {
      "base_url": "{env:DESIGN_PATTERN_EMBEDDER_BASE_URL:-http://design-pattern-tei-embed:8080}",
      "api_key": "{env:DESIGN_PATTERN_EMBEDDER_API_KEY:-}",
      "model": "{env:DESIGN_PATTERN_EMBEDDER_MODEL:-openai//data/embedding-model}",
      "embed_batch_size": "{env:DESIGN_PATTERN_EMBEDDER_BATCH_SIZE:-16}",
      "query_instruction": "{env:DESIGN_PATTERN_EMBEDDER_QUERY_INSTRUCTION:-}",
      "text_instruction": "{env:DESIGN_PATTERN_EMBEDDER_TEXT_INSTRUCTION:-}",
      "model_repo": "{env:DESIGN_PATTERN_EMBED_MODEL_REPO:-}",
      "onnx_variant": "{env:DESIGN_PATTERN_EMBED_ONNX_VARIANT:-}",
      "document_embed_attempts": "{env:DESIGN_PATTERN_EMBEDDER_ATTEMPTS:-10}",
      "document_embed_backoff_seconds": "{env:DESIGN_PATTERN_EMBEDDER_BACKOFF:-2.0}"
    }
  },
  "reranker": {
    "rerank_top_n": "{env:DESIGN_PATTERN_RERANK_TOP_N:-10}",
    "rerank_text": "{env:DESIGN_PATTERN_RERANK_TEXT:-full}",
    "config": {
      "base_url": "{env:DESIGN_PATTERN_RERANKER_BASE_URL:-http://design-pattern-tei-rerank:8080}",
      "model_name": "{env:DESIGN_PATTERN_RERANKER_MODEL:-Alibaba-NLP/gte-reranker-modernbert-base}",
      "api_key": "{env:DESIGN_PATTERN_RERANKER_API_KEY:-}",
      "timeout": "{env:DESIGN_PATTERN_RERANKER_TIMEOUT:-300.0}",
      "max_batch_size": "{env:DESIGN_PATTERN_RERANKER_MAX_BATCH_SIZE:-48}"
    }
  },
  "retrieval": {
    "dense_weight": "{env:DESIGN_PATTERN_RETRIEVAL_DENSE_WEIGHT:-0.7}",
    "bm25_weight": "{env:DESIGN_PATTERN_RETRIEVAL_BM25_WEIGHT:-0.3}",
    "rrf_k": "{env:DESIGN_PATTERN_RETRIEVAL_RRF_K:-60}",
    "min_fusion_score": "{env:DESIGN_PATTERN_RETRIEVAL_MIN_FUSION_SCORE:-0.0}",
    "top_k_candidates": "{env:DESIGN_PATTERN_RETRIEVAL_TOP_K_CANDIDATES:-5}",
    "dense_top_k": "{env:DESIGN_PATTERN_RETRIEVAL_DENSE_TOP_K:-20}",
    "bm25_top_k": "{env:DESIGN_PATTERN_RETRIEVAL_BM25_TOP_K:-20}",
    "max_concurrent_parts": "{env:DESIGN_PATTERN_RETRIEVAL_MAX_CONCURRENT_PARTS:-1}"
  },
  "dense_cache": {
    "path": "{env:DESIGN_PATTERN_DENSE_CACHE_PATH:-/app/data/dense-cache}",
    "mode": "{env:DESIGN_PATTERN_DENSE_CACHE_MODE:-auto}",
    "write": "{env:DESIGN_PATTERN_DENSE_CACHE_WRITE:-true}",
    "probe_timeout_seconds": "{env:DESIGN_PATTERN_DENSE_CACHE_PROBE_TIMEOUT:-120.0}",
    "probe_min_cosine": "{env:DESIGN_PATTERN_DENSE_CACHE_PROBE_MIN_COSINE:-0.999}"
  },
  "scoring": {
    "weight_smoothing_alpha": "{env:DESIGN_PATTERN_SCORING_WEIGHT_SMOOTHING_ALPHA:-0.7}",
    "analysis_blend_weight": "{env:DESIGN_PATTERN_SCORING_ANALYSIS_BLEND_WEIGHT:-0.7}",
    "fusion_blend_weight": "{env:DESIGN_PATTERN_SCORING_FUSION_BLEND_WEIGHT:-0.3}",
    "scope_bonus": "{env:DESIGN_PATTERN_SCORING_SCOPE_BONUS:-3}",
    "category_match": "{env:DESIGN_PATTERN_SCORING_CATEGORY_MATCH:-5}",
    "category_mismatch": "{env:DESIGN_PATTERN_SCORING_CATEGORY_MISMATCH:--10}",
    "style_affinity": "{env:DESIGN_PATTERN_SCORING_STYLE_AFFINITY:-5}",
    "language_support_bonus": "{env:DESIGN_PATTERN_SCORING_LANGUAGE_SUPPORT_BONUS:-2}",
    "language_manual_penalty": "{env:DESIGN_PATTERN_SCORING_LANGUAGE_MANUAL_PENALTY:--2}",
    "missing_axis_default": "{env:DESIGN_PATTERN_SCORING_MISSING_AXIS_DEFAULT:-5.0}"
  },
  "selection": {
    "primary_score_threshold": "{env:DESIGN_PATTERN_SELECTION_PRIMARY_SCORE_THRESHOLD:-50}",
    "supporting_score_threshold": "{env:DESIGN_PATTERN_SELECTION_SUPPORTING_SCORE_THRESHOLD:-40}",
    "near_tie_margin": "{env:DESIGN_PATTERN_SELECTION_NEAR_TIE_MARGIN:-5}",
    "max_supporting": "{env:DESIGN_PATTERN_SELECTION_MAX_SUPPORTING:-3}",
    "max_parts": "{env:DESIGN_PATTERN_SELECTION_MAX_PARTS:-8}"
  },
  "loop": {
    "max_tries": "{env:DESIGN_PATTERN_LOOP_MAX_TRIES:-2}",
    "min_quality_score": "{env:DESIGN_PATTERN_LOOP_MIN_QUALITY_SCORE:-50}"
  },
  "paths": {
    "pattern_directory": "{env:DESIGN_PATTERN_PATTERN_DIRECTORY:-pattern}",
    "docs_directory": "{env:DESIGN_PATTERN_DOCS_DIRECTORY:-docs}"
  },
  "jobs": {
    "db_path": "{env:DESIGN_PATTERN_JOBS_DB:-~/.config/design-pattern-mcp/jobs.db}"
  },
  "reasoning": {
    "enabled": "{env:REASONING_ENABLED:-true}",
    "shannonthinking_cmd": "{env:REASONING_SHANNONTHINKING_CMD:-}",
    "code_reasoning_cmd": "{env:REASONING_CODE_REASONING_CMD:-}",
    "spawn_timeout_seconds": "{env:REASONING_SPAWN_TIMEOUT_SECONDS:-10}",
    "step_timeout_seconds": "{env:REASONING_STEP_TIMEOUT_SECONDS:-20}",
    "max_total_steps": "{env:REASONING_MAX_TOTAL_STEPS:-8}",
    "quiet_stderr": "{env:REASONING_QUIET_STDERR:-true}",
    "fail_fast": "{env:REASONING_FAIL_FAST:-false}",
    "max_injected_chars": "{env:REASONING_MAX_INJECTED_CHARS:-}",
    "per_phase": {
      "analyze": {
        "enabled": "{env:REASONING_ANALYZE_ENABLED:-true}",
        "pre_llm_thoughts": "{env:REASONING_ANALYZE_THOUGHTS:-2}",
        "tools": ["shannon", "code"]
      },
      "weights": {
        "enabled": "{env:REASONING_WEIGHTS_ENABLED:-true}",
        "pre_llm_thoughts": "{env:REASONING_WEIGHTS_THOUGHTS:-2}",
        "tools": ["shannon", "code"]
      },
      "generate": {
        "enabled": "{env:REASONING_GENERATE_ENABLED:-true}",
        "pre_llm_thoughts": "{env:REASONING_GENERATE_THOUGHTS:-2}",
        "tools": ["shannon", "code"]
      },
      "evaluate": {
        "enabled": "{env:REASONING_EVALUATE_ENABLED:-true}",
        "pre_llm_thoughts": "{env:REASONING_EVALUATE_THOUGHTS:-2}",
        "tools": ["shannon", "code"]
      }
    }
  },
  "decisions": {
    "enabled": "{env:DESIGN_PATTERN_DECISIONS_ENABLED:-false}",
    "base_url": "{env:DESIGN_PATTERN_DECISIONS_BASE_URL:-https://opencode.ai/inference/systemone/v1}",
    "model": "{env:DESIGN_PATTERN_DECISIONS_MODEL:-jev-1.13-free}",
    "api_key_env": "{env:DESIGN_PATTERN_DECISIONS_API_KEY_ENV:-OPENCODE_API_KEY}",
    "style_confidence_floor": "{env:DESIGN_PATTERN_DECISIONS_STYLE_CONFIDENCE_FLOOR:-0.5}",
    "timeout_seconds": "{env:DESIGN_PATTERN_DECISIONS_TIMEOUT_SECONDS:-5}"
  },
  "validation": {
    "max_retries": "{env:DESIGN_PATTERN_VALIDATION_MAX_RETRIES:-1}",
    "retry_on_fail": "{env:DESIGN_PATTERN_VALIDATION_RETRY_ON_FAIL:-true}",
    "truncation_rerun": "{env:DESIGN_PATTERN_VALIDATION_TRUNCATION_RERUN:-repair}",
    "truncation_boost_max_completion_tokens": "{env:DESIGN_PATTERN_VALIDATION_TRUNCATION_BOOST_TOKENS:-65536}"
  },
  "prompts": {
    "stable_prefix_first": "{env:DESIGN_PATTERN_PROMPT_STABLE_PREFIX:-false}"
  },
  "litellm_log_level": "{env:DESIGN_PATTERN_LITELLM_LOG_LEVEL:-WARNING}",
  "tasks": {
    "heartbeat_enabled": "{env:DESIGN_PATTERN_TASKS_HEARTBEAT_ENABLED:-true}",
    "heartbeat_interval_seconds": "{env:DESIGN_PATTERN_TASKS_HEARTBEAT_INTERVAL_SECONDS:-30}",
    "deadline_seconds": "{env:DESIGN_PATTERN_TASKS_DEADLINE_SECONDS:-1800.0}"
  }
}
