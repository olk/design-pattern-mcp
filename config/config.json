{
  "logging_level": "{env:LOGGING_LEVEL:-INFO}",
  "logging_format": "{env:LOGGING_FORMAT:-json}",
  "transport": "{env:TRANSPORT:-stdio}",
  "host": "{env:HOST:-0.0.0.0}",
  "port": "{env:PORT:-8050}",
  "generator": {
    "provider": "{env:GENERATOR_PROVIDER:-openai}",
    "config": {
      "model": "{env:GENERATOR_MODEL:-gpt-4o-mini}",
      "base_url": "{env:GENERATOR_BASE_URL:-https://api.openai.com/v1}",
      "api_key": "{env:GENERATOR_API_KEY:-}",
      "temperature": "{env:GENERATOR_TEMPERATURE:-0.1}",
      "top_p": "{env:GENERATOR_TOP_P:-1.0}",
      "top_k": "{env:GENERATOR_TOP_K:-20}",
      "timeout_seconds": "{env:GENERATOR_TIMEOUT_SECONDS:-120.0}",
      "generation_batch_size": "{env:GENERATOR_GENERATION_BATCH_SIZE:-5}",
      "generation_max_concurrency": "{env:GENERATION_MAX_CONCURRENCY:-2}",
      "circuit_breaker_failure_threshold": "{env:GENERATOR_CIRCUIT_BREAKER_FAILURE_THRESHOLD:-3}",
      "circuit_breaker_cooldown_seconds": "{env:GENERATOR_CIRCUIT_BREAKER_COOLDOWN_SECONDS:-60.0}"
    }
  },
  "embedder": {
    "provider": "{env:EMBEDDER_PROVIDER:-tei}",
    "config": {
      "base_url": "{env:EMBEDDER_BASE_URL:-http://design-pattern-tei-embed:8080}",
      "api_key": "{env:EMBEDDER_API_KEY:-}",
      "model": "{env:EMBEDDER_MODEL:-openai//data/embedding-model}",
      "embed_batch_size": "{env:EMBEDDER_BATCH_SIZE:-16}",
      "query_instruction": "{env:EMBEDDER_QUERY_INSTRUCTION:-}",
      "text_instruction": "{env:EMBEDDER_TEXT_INSTRUCTION:-}",
      "model_repo": "{env:EMBED_MODEL_REPO:-}",
      "onnx_variant": "{env:EMBED_ONNX_VARIANT:-}",
      "document_embed_attempts": "{env:EMBEDDER_ATTEMPTS:-10}",
      "document_embed_backoff_seconds": "{env:EMBEDDER_BACKOFF:-2.0}"
    }
  },
  "reranker": {
    "rerank_top_n": "{env:RERANK_TOP_N:-10}",
    "rerank_text": "{env:RERANK_TEXT:-full}",
    "config": {
      "base_url": "{env:RERANKER_BASE_URL:-http://design-pattern-tei-rerank:8080}",
      "model_name": "{env:RERANKER_MODEL:-Alibaba-NLP/gte-reranker-modernbert-base}",
      "api_key": "{env:RERANKER_API_KEY:-}",
      "timeout": "{env:RERANKER_TIMEOUT:-300.0}",
      "max_batch_size": "{env:RERANKER_MAX_BATCH_SIZE:-48}"
    }
  },
  "retrieval": {
    "dense_weight": "{env:RETRIEVAL_DENSE_WEIGHT:-0.7}",
    "bm25_weight": "{env:RETRIEVAL_BM25_WEIGHT:-0.3}",
    "rrf_k": "{env:RETRIEVAL_RRF_K:-60}",
    "min_fusion_score": "{env:RETRIEVAL_MIN_FUSION_SCORE:-0.0}",
    "top_k_candidates": "{env:RETRIEVAL_TOP_K_CANDIDATES:-5}",
    "dense_top_k": "{env:RETRIEVAL_DENSE_TOP_K:-20}",
    "bm25_top_k": "{env:RETRIEVAL_BM25_TOP_K:-20}",
    "max_concurrent_parts": "{env:RETRIEVAL_MAX_CONCURRENT_PARTS:-1}"
  },
  "dense_cache": {
    "path": "{env:DENSE_CACHE_PATH:-/app/data/dense-cache}",
    "mode": "{env:DENSE_CACHE_MODE:-auto}",
    "write": "{env:DENSE_CACHE_WRITE:-true}",
    "probe_timeout_seconds": "{env:DENSE_CACHE_PROBE_TIMEOUT:-120.0}",
    "probe_min_cosine": "{env:DENSE_CACHE_PROBE_MIN_COSINE:-0.999}"
  },
  "scoring": {
    "weight_smoothing_alpha": "{env:SCORING_WEIGHT_SMOOTHING_ALPHA:-0.7}",
    "analysis_blend_weight": "{env:SCORING_ANALYSIS_BLEND_WEIGHT:-0.7}",
    "fusion_blend_weight": "{env:SCORING_FUSION_BLEND_WEIGHT:-0.3}",
    "scope_bonus": "{env:SCORING_SCOPE_BONUS:-3}",
    "category_match": "{env:SCORING_CATEGORY_MATCH:-5}",
    "category_mismatch": "{env:SCORING_CATEGORY_MISMATCH:--10}",
    "style_affinity": "{env:SCORING_STYLE_AFFINITY:-5}",
    "language_support_bonus": "{env:SCORING_LANGUAGE_SUPPORT_BONUS:-2}",
    "language_manual_penalty": "{env:SCORING_LANGUAGE_MANUAL_PENALTY:--2}",
    "missing_axis_default": "{env:SCORING_MISSING_AXIS_DEFAULT:-5.0}"
  },
  "selection": {
    "primary_score_threshold": "{env:SELECTION_PRIMARY_SCORE_THRESHOLD:-50}",
    "supporting_score_threshold": "{env:SELECTION_SUPPORTING_SCORE_THRESHOLD:-40}",
    "near_tie_margin": "{env:SELECTION_NEAR_TIE_MARGIN:-5}",
    "max_supporting": "{env:SELECTION_MAX_SUPPORTING:-3}",
    "max_parts": "{env:SELECTION_MAX_PARTS:-8}"
  },
  "loop": {
    "max_tries": "{env:LOOP_MAX_TRIES:-2}",
    "min_quality_score": "{env:LOOP_MIN_QUALITY_SCORE:-50}"
  },
  "paths": {
    "pattern_directory": "{env:PATTERN_DIRECTORY:-pattern}",
    "docs_directory": "{env:DOCS_DIRECTORY:-docs}"
  },
  "jobs": {
    "db_path": "{env:JOBS_DB:-~/.config/design-pattern-mcp/jobs.db}"
  },
  "reasoning": {
    "enabled": "{env:REASONING_ENABLED:-true}",
    "shannonthinking_cmd": "{env:REASONING_SHANNONTHINKING_CMD:-}",
    "code_reasoning_cmd": "{env:REASONING_CODE_REASONING_CMD:-}",
    "spawn_timeout_seconds": "{env:REASONING_SPAWN_TIMEOUT_SECONDS:-10}",
    "step_timeout_seconds": "{env:REASONING_STEP_TIMEOUT_SECONDS:-20}",
    "max_total_steps": "{env:REASONING_MAX_TOTAL_STEPS:-8}",
    "quiet_stderr": "{env:REASONING_QUIET_STDERR:-true}",
    "fail_fast": "{env:REASONING_FAIL_FAST:-false}",
    "max_injected_chars": "{env:REASONING_MAX_INJECTED_CHARS:-}",
    "per_phase": {
      "analyze": {
        "enabled": "{env:REASONING_ANALYZE_ENABLED:-true}",
        "pre_llm_thoughts": "{env:REASONING_ANALYZE_THOUGHTS:-2}",
        "tools": ["shannon", "code"]
      },
      "weights": {
        "enabled": "{env:REASONING_WEIGHTS_ENABLED:-true}",
        "pre_llm_thoughts": "{env:REASONING_WEIGHTS_THOUGHTS:-2}",
        "tools": ["shannon", "code"]
      },
      "generate": {
        "enabled": "{env:REASONING_GENERATE_ENABLED:-true}",
        "pre_llm_thoughts": "{env:REASONING_GENERATE_THOUGHTS:-2}",
        "tools": ["shannon", "code"]
      },
      "evaluate": {
        "enabled": "{env:REASONING_EVALUATE_ENABLED:-true}",
        "pre_llm_thoughts": "{env:REASONING_EVALUATE_THOUGHTS:-2}",
        "tools": ["shannon", "code"]
      }
    }
  },
  "decisions": {
    "enabled": "{env:DECISIONS_ENABLED:-false}",
    "base_url": "{env:DECISIONS_BASE_URL:-https://opencode.ai/inference/systemone/v1}",
    "model": "{env:DECISIONS_MODEL:-jev-1.13-free}",
    "api_key_env": "{env:DECISIONS_API_KEY_ENV:-OPENCODE_API_KEY}",
    "style_confidence_floor": "{env:DECISIONS_STYLE_CONFIDENCE_FLOOR:-0.5}",
    "timeout_seconds": "{env:DECISIONS_TIMEOUT_SECONDS:-5}"
  },
  "validation": {
    "max_retries": "{env:VALIDATION_MAX_RETRIES:-1}",
    "retry_on_fail": "{env:VALIDATION_RETRY_ON_FAIL:-true}",
    "truncation_rerun": "{env:VALIDATION_TRUNCATION_RERUN:-repair}",
    "truncation_boost_max_completion_tokens": "{env:VALIDATION_TRUNCATION_BOOST_TOKENS:-65536}"
  },
  "prompts": {
    "stable_prefix_first": "{env:PROMPT_STABLE_PREFIX:-false}"
  },
  "litellm_log_level": "{env:LITELLM_LOG_LEVEL:-WARNING}",
  "tasks": {
    "heartbeat_enabled": "{env:TASKS_HEARTBEAT_ENABLED:-true}",
    "heartbeat_interval_seconds": "{env:TASKS_HEARTBEAT_INTERVAL_SECONDS:-30}",
    "deadline_seconds": "{env:TASKS_DEADLINE_SECONDS:-1800.0}"
  }
}
