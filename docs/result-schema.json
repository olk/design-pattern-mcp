{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "design-result-schema",
  "title": "DesignResult",
  "description": "Design pattern application result schema — top-level fields match src/schemas/design.py::DesignResult; definition subschemas match their respective schema classes",
  "type": "object",
  "required": [
    "overview",
    "applications"
  ],
  "properties": {
    "overview": {
      "$ref": "#/definitions/DesignOverview"
    },
    "applications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/PatternApplication"
      }
    },
    "interactions": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/definitions/Interaction"
      }
    },
    "quality_attributes": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "default": {}
    },
    "test_strategy": {
      "$ref": "#/definitions/TestStrategy"
    },
    "risks": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/definitions/Risk"
      }
    }
  },
  "definitions": {
    "patternCategory": {
      "type": "string",
      "enum": [
        "domain-modeling",
        "construction-composition",
        "behavior-selection",
        "interaction-boundary",
        "workflow-messaging",
        "persistence-state",
        "concurrency-resilience",
        "security-verification",
        "specialized-components"
      ],
      "description": "Decision group that owns the applied pattern"
    },
    "language": {
      "type": "string",
      "enum": [
        "generic",
        "c",
        "cplusplus",
        "csharp",
        "go",
        "java",
        "javascript",
        "kotlin",
        "python",
        "ruby",
        "rust",
        "scala",
        "swift",
        "typescript"
      ],
      "description": "Language of a binding ('generic' for language-neutral guidance)"
    },
    "supportLevel": {
      "type": "string",
      "enum": [
        "native",
        "idiomatic",
        "library",
        "manual",
        "discouraged"
      ],
      "description": "How the bound language relates to the classic pattern structure (native/idiomatic/library/manual/discouraged)"
    },
    "paradigm": {
      "type": "string",
      "enum": [
        "oo",
        "functional",
        "concurrent",
        "data-oriented",
        "declarative",
        "procedural"
      ],
      "description": "Programming paradigm of a realization variant (mirrors docs/pattern-schema.json definitions.paradigm — the single source of truth)"
    },
    "LanguageBinding": {
      "type": "object",
      "required": [
        "language",
        "support",
        "implementation_notes"
      ],
      "properties": {
        "language": {
          "$ref": "#/definitions/language"
        },
        "support": {
          "$ref": "#/definitions/supportLevel"
        },
        "idiom_name": {
          "type": "string",
          "description": "Name of the concrete realization used here (e.g. 'function type', 'EventEmitter with typed event map')"
        },
        "implementation_notes": {
          "type": "string",
          "description": "How the pattern is realized in this language for this application"
        },
        "code_sketch": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Short illustrative fragment in the bound language"
        },
        "alternative": {
          "type": "string",
          "description": "Preferred replacement if support is 'discouraged'"
        },
        "bound_variant": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "description": "variant_id of the realization bound for this application (§8.4 precedence ladder); present iff the bound language entry carries variants. Named separately from implementation_notes so the choice is machine-readable and quotable in a follow-up focus hint."
        },
        "variants": {
          "type": "array",
          "maxItems": 5,
          "description": "Sibling realizations that were NOT bound — compact summaries (no code sketches/notes) so the agent can judge floor/paradigm fit against the actual codebase and, when wrong, re-call the design tool with focus quoting a variant_id. Present iff the bound entry carries variants beyond the bound one.",
          "items": {
            "type": "object",
            "required": [
              "variant_id",
              "name",
              "paradigm"
            ],
            "properties": {
              "variant_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
              },
              "name": {
                "type": "string"
              },
              "paradigm": {
                "$ref": "#/definitions/paradigm"
              },
              "min_standard": {
                "type": "string"
              },
              "requires_features": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "SupportingPattern": {
      "type": "object",
      "required": [
        "pattern",
        "role"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "description": "Canonical catalog name of the supporting pattern"
        },
        "role": {
          "type": "string",
          "description": "The distinct constraint this supporting pattern solves for the primary decision"
        }
      }
    },
    "DesignOverview": {
      "type": "object",
      "required": [
        "reasoning",
        "primary_pattern",
        "category"
      ],
      "properties": {
        "reasoning": {
          "type": "string",
          "description": "Why the primary pattern owns this decision (decision-first rationale)"
        },
        "primary_pattern": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "description": "Canonical catalog name of the primary pattern"
        },
        "category": {
          "$ref": "#/definitions/patternCategory"
        },
        "supporting_patterns": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/definitions/SupportingPattern"
          }
        },
        "principles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "languages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/language"
          },
          "default": [],
          "description": "Target languages of the request (authoritative bindings live per application)"
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "description": "Evaluation stage score"
        }
      }
    },
    "Participant": {
      "type": "object",
      "required": [
        "role",
        "maps_to",
        "responsibility"
      ],
      "properties": {
        "role": {
          "type": "string",
          "description": "Abstract participant role from the pattern definition"
        },
        "maps_to": {
          "type": "string",
          "description": "Concrete code entity realizing the role (class, function, module, type)"
        },
        "responsibility": {
          "type": "string",
          "description": "What this participant is responsible for in the collaboration"
        }
      }
    },
    "ApplicationInteraction": {
      "type": "object",
      "required": [
        "from",
        "to",
        "description"
      ],
      "properties": {
        "from": {
          "type": "string",
          "description": "Originating participant role (or 'client')"
        },
        "to": {
          "type": "string",
          "description": "Receiving participant role"
        },
        "description": {
          "type": "string",
          "description": "What is sent, called or delegated"
        }
      }
    },
    "PatternApplication": {
      "type": "object",
      "required": [
        "id",
        "pattern",
        "name",
        "problem",
        "solution"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "Unique application identifier"
        },
        "pattern": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "description": "Canonical catalog pattern name being applied"
        },
        "category": {
          "$ref": "#/definitions/patternCategory"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Human-readable name of this concrete application"
        },
        "problem": {
          "type": "string",
          "minLength": 1,
          "description": "The concrete problem in the target component this application solves"
        },
        "solution": {
          "type": "string",
          "minLength": 1,
          "description": "How the pattern is realized here"
        },
        "participants": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/definitions/Participant"
          },
          "description": "Abstract-role-to-concrete-entity mapping for this application"
        },
        "interactions": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/definitions/ApplicationInteraction"
          },
          "description": "Collaborations inside this application"
        },
        "implementation_steps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Ordered, agent-actionable implementation steps"
        },
        "code_sketch": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Illustrative fragment in the bound language (guidance, not verbatim output)"
        },
        "language_binding": {
          "$ref": "#/definitions/LanguageBinding",
          "description": "Concrete language realization for THIS application (patterns mixed in one design may bind differently)"
        },
        "test_notes": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "How to test this application: seams, doubles, what to assert"
        },
        "alternatives_considered": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Rejected alternatives and why"
        }
      }
    },
    "Interaction": {
      "type": "object",
      "required": [
        "source",
        "target",
        "type",
        "description"
      ],
      "properties": {
        "source": {
          "type": "string",
          "description": "Source application id"
        },
        "target": {
          "type": "string",
          "description": "Target application id"
        },
        "type": {
          "type": "string",
          "description": "Interaction kind (e.g. 'notifies', 'delegates-to', 'invalidates')"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "Risk": {
      "type": "object",
      "required": [
        "risk",
        "mitigation"
      ],
      "properties": {
        "risk": {
          "type": "string",
          "description": "What can go wrong with this design"
        },
        "mitigation": {
          "type": "string",
          "description": "How to prevent or contain it"
        }
      }
    },
    "TestStrategy": {
      "type": "object",
      "required": [
        "approach"
      ],
      "properties": {
        "approach": {
          "type": "string",
          "description": "Overall testing approach for the design"
        },
        "test_seams": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Injection points and seams the design provides for testing (humble objects, doubles, contracts)"
        }
      }
    }
  }
}
